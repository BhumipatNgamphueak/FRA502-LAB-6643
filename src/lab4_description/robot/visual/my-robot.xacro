<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lab4">
  
  <!-- Materials -->
  <material name="blue"><color rgba="0.2 0.2 1 1"/></material>
  <material name="orange"><color rgba="1 0.3 0.1 1"/></material>
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- World -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="link_0"/>
  </joint>

  <!-- Link 0 (Base) -->
  <link name="link_0">
    <visual>
      <geometry><mesh filename="package://lab4_description/meshes/link_0.stl"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- Link 1 -->
  <link name="link_1">
    <visual>
      <geometry><mesh filename="package://lab4_description/meshes/link_1.stl"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/> 
    <axis xyz="0 0 1"/>
    <limit lower="-3.1459" upper="3.1459" velocity="2.0" effort="10.0"/>
  </joint>

  <!-- Link 2 -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/> 
      <geometry><mesh filename="package://lab4_description/meshes/link_2.stl"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 -0.12 0" rpy="-1.5708 0 0"/> 
    <axis xyz="0 0 1"/>
    <limit lower="-3.1459" upper="3.1459" velocity="2.0" effort="10.0"/>
  </joint>

  <!-- Link 3 -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/> 
      <geometry><mesh filename="package://lab4_description/meshes/link_3.stl"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 -0.25 0.1" rpy="0 0 0"/> 
    <axis xyz="0 0 1"/>
    <limit lower="-3.1459" upper="3.1459" velocity="2.0" effort="10.0"/>
  </joint>

  <!-- End Effector -->
  <link name="end_effector">
    <visual>
      <geometry><mesh filename="package://lab4_description/meshes/end_effector.stl"/></geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="joint_end_effector" type="fixed">
    <parent link="link_3"/>
    <child link="end_effector"/>
    <origin xyz="0 -0.28 0" rpy="1.5708 0 0"/> 
  </joint>

</robot>